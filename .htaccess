# LisbonTuk4U - Production .htaccess configuration for Hostinger (LiteSpeed)

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 0. Consolidar dominio canonico (301):
    #    tours.lisbontuk4u.com (staging antigo) e www.lisbontuk4u.com  ->  lisbontuk4u.com
    #    Evita conteudo duplicado e concentra a autoridade SEO num so dominio.
    #    O caminho e preservado (ex.: tours.../tours/belem.html -> .../tours/belem.html).
    RewriteCond %{HTTP_HOST} ^tours\.lisbontuk4u\.com$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^www\.lisbontuk4u\.com$ [NC]
    RewriteRule ^(.*)$ https://lisbontuk4u.com/$1 [R=301,L]

    # Redirect trailing slashes for subfolders if needed
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*[^/])$ /$1/ [R=301,L]

    # 0.5 URLs limpos: /about -> serve about.html sem mudar o URL na barra
    #     de enderecos (rewrite interno, nao e redirect). Corrige links
    #     antigos/indexados no Google sem extensao (.html) que davam 404.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# 1. Prevent LiteSpeed Caching (LSCache) for dynamic endpoints
# Essential to prevent payment session sharing and cached slots mismatch
<IfModule LiteSpeed>
    # Disable cache for checkouts, pricing, and availability queries
    RewriteCond %{REQUEST_URI} ^/api/.*$ [OR]
    RewriteCond %{REQUEST_URI} ^/checkout/.*$ [OR]
    RewriteCond %{REQUEST_URI} (availability|pricing|checkout)\.php$
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# 2. Browser Caching for static assets (Leverage Browser Caching)
# Optimizes site speed for mobile traffic (First Contentful Paint)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML e sitemap/robots: cache CURTA — o conteudo muda e deve propagar
    # depressa (a CDN da Hostinger respeita estes cabecalhos). Os assets
    # estaticos abaixo usam ?v= no URL, por isso mantem-se com cache longa.
    ExpiresByType text/html "access plus 10 minutes"
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType text/xml "access plus 1 hour"

    # Images (WebP, PNG, JPG, ICO)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Fonts
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# 3. Gzip Compression for text-based assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
